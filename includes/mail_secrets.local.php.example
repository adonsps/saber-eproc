<?php
// includes/mail_secrets.local.php  (COPY this file to that name; the real one is gitignored)
//
// Fallback SMTP credential delivery for a deploy that has no docker-compose
// environment (the Hostinger shared-hosting checkout). The Docker/VPS deploy
// does NOT use this file — it gets the same values from the container
// environment via docker-compose.prod.yml. Keep the two in sync when the
// password is rotated.
//
// mail_config.php prefers getenv() over this file, so leaving a stale value
// here is harmless on the container but IS the live value on bare Hostinger.

return [
    'host'       => 'smtp.gmail.com',
    'port'       => 465,
    'username'   => 'sigit.ramadan@kawanlamacorp.com',
    'password'   => '', // <-- put the Google App Password for that account here
    'from_email' => '', // blank => same as username (kawanlamacorp.com DMARC requires it)
    'from_name'  => 'VSS - Vendor Sourcing System',
];
