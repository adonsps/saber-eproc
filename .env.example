# Nightly VSS backup (backups/backup.php on Hostinger -> backups/receive_backup.php on the VPS)
#
# URL: the public HTTPS URL the VPS answers backups/receive_backup.php on
# (through Nginx Proxy Manager), e.g. https://<vps-domain>/backups/receive_backup.php
#
# SECRET: shared token — must be the SAME value here (sender, Hostinger) and
# in the VPS container's own environment (VSS_BACKUP_RECEIVER_SECRET in
# docker-compose.prod.yml / the VPS's untracked .env beside it). Generate
# with: php -r "echo bin2hex(random_bytes(32));"
VSS_BACKUP_RECEIVER_URL=
VSS_BACKUP_RECEIVER_SECRET=

# Vendor Evaluation v2 — WhatsApp reminders (Fonnte)
#
# TOKEN for the Vendor-Eval-specific Fonnte device. Read inside the VPS app
# container by workspace/includes/vendor_eval_v2_fonnte.php via
# getenv('VE2_FONNTE_TOKEN'), and wired into the container by
# docker-compose.prod.yml. The WA reminder sender FAILS CLOSED (sends nothing,
# logs "token is not configured") when this is blank, and never falls back to
# the shared FONNTE_TOKEN. Set the real value in the VPS's untracked .env
# beside docker-compose.prod.yml — never commit it here.
VE2_FONNTE_TOKEN=

# Gemini AI — per-feature API keys (workspace side)
#
# Each Workspace AI feature group used to share ONE hardcoded Gemini key
# (workspace/config/gemini_api.php). They now each read their own key via
# workspace/config/gemini_api.php's gemini_key_*() getters, wired into the
# container by docker-compose.yml (dev, blank-safe) / docker-compose.prod.yml
# (prod, no default — the feature throws "not configured" until this is set).
# Real values are 10 NEW Gemini API keys generated in Google AI Studio /
# Google Cloud Console (a manual step, not part of any code change) and live
# only in the VPS's untracked .env beside docker-compose.prod.yml — never
# commit them here.
#   AI_PO_TAXONOMY_API_KEY   -> PO taxonomy mapping/autofill/golden-rule/SLA-automap
#   AI_TICKET_ASSIGN_API_KEY -> AI ticket auto-assign
#   AI_SKU_API_KEY           -> SKU dictionary/dedupe/auto-generate
#   AI_VENDOR_SUGGEST_API_KEY-> Vendor AI suggest (internal/external/reassign)
#   AI_SLA_CHAT_API_KEY      -> SLA chatbot widget
#   AI_ADMIN_MISC_API_KEY    -> Cost avoidance AI, master-data rename, PR migration mapping
AI_PO_TAXONOMY_API_KEY=
AI_TICKET_ASSIGN_API_KEY=
AI_SKU_API_KEY=
AI_VENDOR_SUGGEST_API_KEY=
AI_SLA_CHAT_API_KEY=
AI_ADMIN_MISC_API_KEY=

# Gemini AI — per-feature API keys (vendor-portal side, modules/vendor/*.php)
#
# These 4 files never shared workspace/config/gemini_api.php's key — each had
# its own independent hardcoded literal. Same rules as above: new keys, VPS
# untracked .env only, wired by docker-compose.prod.yml.
#   AI_VENDOR_DOC_EXTRACT_API_KEY      -> modules/vendor/extract_doc_ai.php
#   AI_VENDOR_PROJECT_VALIDATE_API_KEY -> modules/vendor/validate_project_ai.php
#   AI_VENDOR_BIZ_SUGGEST_API_KEY      -> modules/vendor/suggest_biz_ai.php
#   AI_VENDOR_PROFILE_SUMMARY_API_KEY  -> modules/vendor/generate_profile_summary_ai.php
AI_VENDOR_DOC_EXTRACT_API_KEY=
AI_VENDOR_PROJECT_VALIDATE_API_KEY=
AI_VENDOR_BIZ_SUGGEST_API_KEY=
AI_VENDOR_PROFILE_SUMMARY_API_KEY=

# VSS DB credential used by workspace/config/database.php's get_vss_pdo()
# (shared connection to the u894129685_vmsportal database: vendors, taxonomy,
# VSS user credentials). Read via getenv('VSS_DB_NAME'/'VSS_DB_USER'/
# 'VSS_DB_PASSWORD'), same variable names tools/vss_maintenance.php already
# used in isolation. All 3 default to today's existing hardcoded credential
# if left blank, so leaving this section blank changes NOTHING — it exists so
# the credential can be rotated later without a code change. If you do set a
# real rotated value, set it only in the VPS's untracked .env, never here.
VSS_DB_NAME=
VSS_DB_USER=
VSS_DB_PASSWORD=

# Shared outbound SMTP mailbox, read by includes/mail_config.php. Now the
# Google Workspace account sigit.ramadan@kawanlamacorp.com (smtp.gmail.com:465),
# replacing the Hostinger-restricted corporateprocurement@vssportal.online.
# Host/port/username/from-name fall back to those values when blank. Set
# SMTP_PASSWORD to a Google App Password for that account (2-Step Verification
# required; the normal login password is refused over SMTP). Never commit it.
# SMTP_FROM_EMAIL is optional and defaults to SMTP_USERNAME -- kawanlamacorp.com
# enforces DMARC p=reject, so the From must stay that same Google account.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
# Put the mailbox password between single quotes so characters like $ # ! stay literal:
#   SMTP_PASSWORD='your-mailbox-password-here'
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Mail send-rate guardrail (includes/mail_rate_limiter.php)
#
# Caps combined recipient-slot volume (To+Cc+Bcc, the way Hostinger's quota
# counts) across EVERY sender that routes through mail_rate_limited_send(), in
# a rolling 5-minute burst window and a rolling 1-hour window, to stop a repeat
# of the "aktivitas gak wajar" spam block on corporateprocurement@vssportal.online.
# Leave blank to use the code defaults (15 / 5 min, 60 / hour, deliberately
# under the ~100/hour ceiling implied by tools/PREPARE_MANUAL_INVITE.md); raise
# only once real headroom against the current Hostinger account is confirmed.
MAIL_RATE_LIMIT_BURST=
MAIL_RATE_LIMIT_HOURLY=

# Reminder Vendor Migrasi bulk send gate (includes/migrated_reminder_helper.php).
# OFF unless exactly 1: the page greys out "Kirim Reminder" and the send endpoint
# refuses. Turn on only for an approved run, then set back to 0 and run
# `docker compose -f docker-compose.prod.yml up -d` after each change.
# DAILY_CAP = max reminders per rolling 24h across all operators (blank => 50).
MIGRATED_REMINDER_SEND_ENABLED=0
MIGRATED_REMINDER_DAILY_CAP=
