<?php
// pages/master_data.php
require_once '../includes/auth.php';
// We now allow all managers in, but restrict what they can do via $_SESSION['role']
require_manager(); 
require_once '../config/database.php';

// DEKLARASIKAN VARIABEL DI SINI SEBELUM CEK POST
$role = $_SESSION['role'] ?? '';
$current_user = $_SESSION['name'] ?? '';

// --- 2. HANDLE MANUAL / SUGGESTION UPDATES ---
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['update_pic'], $_POST['level_4_key'])) {
    
    $new_pic_names = '';
    if (isset($_POST['pic_names_arr']) && is_array($_POST['pic_names_arr'])) {
        $new_pic_names = implode(', ', array_map('trim', $_POST['pic_names_arr']));
    }
    
    $level_4_key = $_POST['level_4_key']; 

    if ($role === 'Category Manager') {
        // Category Managers directly overwrite the mapping AND clear any pending suggestions
        $updateStmt = $pdo->prepare("UPDATE master_data SET pic_names = ?, suggested_pic_names = NULL, suggested_by = NULL WHERE level_4 = ?");
        $updateStmt->execute([$new_pic_names, $level_4_key]);
        header("Location: master_data.php?manual_update=1");
    } else {
        // Standard Managers only log a suggestion
        $updateStmt = $pdo->prepare("UPDATE master_data SET suggested_pic_names = ?, suggested_by = ? WHERE level_4 = ?");
        $updateStmt->execute([$new_pic_names, $current_user, $level_4_key]);
        header("Location: master_data.php?suggest_update=1");
    }
    exit;
}

require_once '../includes/header.php';

$uploadMessage = '';

// --- 1. HANDLE CSV UPLOAD (CATEGORY MANAGERS ONLY) ---
if ($role === 'Category Manager' && $_SERVER['REQUEST_METHOD'] === 'POST' && isset($_FILES['taxonomy_file'])) {
    $file = $_FILES['taxonomy_file'];
    
    if ($file['error'] === UPLOAD_ERR_OK) {
        $ext = pathinfo($file['name'], PATHINFO_EXTENSION);
        
        if (strtolower($ext) === 'csv') {
            $tmpPath = $file['tmp_name'];
            $handle = fopen($tmpPath, "r");
            
            if ($handle !== FALSE) {
                $insertedCount = 0;
                $updatedCount = 0;
                
                fgetcsv($handle, 1000, ","); // Skip header
                
                // Note: We clear any pending suggestions if a CSV overwrites the row
                $sql = "INSERT INTO master_data (level_0, level_1, level_2, level_3, level_4, pic_names) 
                        VALUES (?, ?, ?, ?, ?, ?) 
                        ON DUPLICATE KEY UPDATE 
                        level_0 = VALUES(level_0), level_1 = VALUES(level_1), 
                        level_2 = VALUES(level_2), level_3 = VALUES(level_3), 
                        pic_names = VALUES(pic_names),
                        suggested_pic_names = NULL, suggested_by = NULL";
                
                $stmt = $pdo->prepare($sql);
                
                while (($data = fgetcsv($handle, 1000, ",")) !== FALSE) {
                    if (!isset($data[4]) || !isset($data[5]) || trim($data[4]) === '') {
                        continue; 
                    }
                    
                    $level_0 = isset($data[0]) ? trim($data[0]) : '';
                    $level_1 = isset($data[1]) ? trim($data[1]) : '';
                    $level_2 = isset($data[2]) ? trim($data[2]) : '';
                    $level_3 = isset($data[3]) ? trim($data[3]) : '';
                    $level_4 = trim($data[4]); 
                    $pic_names = trim($data[5]);
                    
                    $stmt->execute([$level_0, $level_1, $level_2, $level_3, $level_4, $pic_names]);
                    
                    if ($stmt->rowCount() == 1) {
                        $insertedCount++;
                    } elseif ($stmt->rowCount() == 2) {
                        $updatedCount++;
                    }
                }
                fclose($handle);
                
                $uploadMessage = "<div class='bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 shadow-sm rounded'>
                    <p class='font-bold'>Knowledge Base Updated!</p>
                    <p>Inserted $insertedCount new rules. Updated $updatedCount existing rules.</p>
                </div>";
            } else {
                $uploadMessage = "<div class='bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6'>Could not read the CSV file.</div>";
            }
        } else {
            $uploadMessage = "<div class='bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6'>Please upload a valid .csv file.</div>";
        }
    } else {
        $uploadMessage = "<div class='bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6'>File upload error.</div>";
    }
}

// --- 3. FETCH DATA FOR UI ---
// SEKARANG MENGAMBIL LEVEL 0 JUGA DARI DATABASE
$stmt = $pdo->query("SELECT level_0, level_1, level_2, level_3, level_4, pic_names, suggested_pic_names, suggested_by FROM master_data ORDER BY level_0, level_1, level_2, level_3, level_4");
$taxonomy_data = $stmt->fetchAll();

// Extract unique arrays for quick filters and column dropdowns (Level 0, 1, 2)
$unique_level_0 = array_filter(array_unique(array_column($taxonomy_data, 'level_0')));
$unique_level_1 = array_filter(array_unique(array_column($taxonomy_data, 'level_1')));
$unique_level_2 = array_filter(array_unique(array_column($taxonomy_data, 'level_2')));
sort($unique_level_0);
sort($unique_level_1);
sort($unique_level_2);

$picStmt = $pdo->query("SELECT name FROM users WHERE role = 'PIC' ORDER BY name ASC");
$all_pics = $picStmt->fetchAll(PDO::FETCH_COLUMN);
?>

