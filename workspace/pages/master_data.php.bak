                  </div>
              <?php else: ?>
                  <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 sm:mx-0 sm:h-10 sm:w-10">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                  </div>
              <?php endif; ?>

              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                <h3 class="text-lg font-medium text-gray-900">
                    <?= $role === 'Category Manager' ? 'Update Routing Rule' : 'Suggest Routing Change' ?>
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500 mb-4">Edit the PIC assignment for: <strong id="modal-cat-display" class="text-indigo-600"></strong></p>
                  
                  <input type="hidden" name="level_4_key" id="modal-l4-input">
                  <input type="hidden" name="update_pic" value="1">
                  
                  <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide">Assign PIC(s)</label>
                  <div class="border border-gray-300 rounded-md overflow-hidden bg-white shadow-sm">
                      <div class="p-2 border-b bg-gray-50">
                          <input type="text" id="modal-pic-search" class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-indigo-500 focus:border-indigo-500" placeholder="Search PIC name...">
                      </div>
                      <div class="max-h-48 overflow-y-auto p-2" id="modal-pic-list">
                          <?php foreach ($all_pics as $pic): ?>
                              <label class="flex items-center p-2 hover:bg-indigo-50 rounded cursor-pointer transition-colors border-b border-gray-50 last:border-0">
                                  <input type="checkbox" name="pic_names_arr[]" value="<?= htmlspecialchars($pic) ?>" class="modal-pic-checkbox h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500">
                                  <span class="ml-3 text-sm text-gray-700 font-medium pic-name-label"><?= htmlspecialchars($pic) ?></span>
                              </label>
                          <?php endforeach; ?>
                      </div>
                  </div>
                  
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 <?= $role === 'Category Manager' ? 'bg-indigo-600 hover:bg-indigo-700' : 'bg-yellow-500 hover:bg-yellow-600' ?> text-base font-medium text-white sm:ml-3 sm:w-auto sm:text-sm">
                <?= $role === 'Category Manager' ? 'Save Rule' : 'Submit Suggestion' ?>
            </button>
            <button type="button" id="closeModalBtn" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">Cancel</button>
          </div>
      </form>
    </div>
  </div>
</div>

<script>
    $(document).ready(function() {
        var table = $('#masterTable').DataTable({
            "pageLength": 50,
            "language": { "search": "Global Search:" },
            "orderCellsTop": true // VERY IMPORTANT for complex headers
        });

        // 1. FILTER: Team Filter Buttons (Sekarang menggunakan Level 0)
        $('.team-filter-btn').on('click', function() {
            var team = $(this).data('team');
            
            // Visual feedback
            $('.team-filter-btn').removeClass('ring-2 ring-offset-2 ring-indigo-400 bg-indigo-50 text-indigo-700').addClass('bg-white text-gray-600 border-gray-200');
            $(this).removeClass('bg-white text-gray-600 border-gray-200').addClass('ring-2 ring-offset-2 ring-indigo-400 bg-indigo-50 text-indigo-700');

            // Apply filter to Level 0 (Col 0)
            if (team === '') {
                table.column(0).search('', false, false).draw();
            } else {
                table.column(0).search('^' + $.fn.dataTable.util.escapeRegex(team) + '$', true, false).draw();
            }
        });

        // 2. FILTER: Suggestion Quick Filters
        $('.quick-filter-btn').on('click', function() {
            var status = $(this).data('status');
            $('.quick-filter-btn').removeClass('ring-2 ring-offset-2 ring-gray-400 ring-yellow-400');
            $(this).addClass('ring-2 ring-offset-2 ' + (status === '' ? 'ring-gray-400' : 'ring-yellow-400'));

            // Column 5 adalah kolom Assigned PIC(s) sekarang, bukan lagi 4.
            table.column(5).search(status).draw();
        });

        // 3. DATATABLES: Dropdown Column Filters Logic
        $('.column-search-text').on('keyup change clear', function(e) {
            e.stopPropagation();
            table.column($(this).data('col')).search(this.value).draw();
        });

        $('.filter-trigger').on('click', function(e) {
            e.stopPropagation();
            var $th = $(this).closest('th.th-filter');
            var $dropdown = $(this).next('.filter-dropdown');
            $('th.th-filter').css('z-index', '10');
            $('.filter-dropdown').not($dropdown).addClass('hidden');

            if ($dropdown.hasClass('hidden')) {
                $dropdown.removeClass('hidden');
                $th.css('z-index', '50');
            } else {
                $dropdown.addClass('hidden');
            }
        });

        $(document).on('click', function() { $('.filter-dropdown').addClass('hidden'); $('th.th-filter').css('z-index', '10'); });
        $('.filter-dropdown').on('click', function(e) { e.stopPropagation(); });
        $('thead input').on('click', function(e) { e.stopPropagation(); });

        $('.dropdown-search').on('keyup', function() {
            var searchTerm = $(this).val().toLowerCase();
            var $list = $(this).closest('.filter-dropdown').find('.checkbox-list label');
            $list.each(function() {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(searchTerm) > -1);
            });
        });

        $('.select-all-checkbox').on('change', function() {
            var isChecked = $(this).prop('checked');
            $(this).closest('.filter-dropdown').find('.checkbox-list label:visible .col-checkbox').prop('checked', isChecked);
        });

        $('.apply-filter').on('click', function() {
            var colIdx = $(this).data('col');
            var $dropdown = $(this).closest('.filter-dropdown');
            var selected = [];
            $dropdown.find('.col-checkbox:checked').each(function() { selected.push($.fn.dataTable.util.escapeRegex($(this).val())); });

            if (selected.length === 0) {
                table.column(colIdx).search('', false, false).draw();
            } else {
                table.column(colIdx).search('^(' + selected.join('|') + ')$', true, false).draw();
            }
            $dropdown.addClass('hidden');
            $('th.th-filter').css('z-index', '10');
        });

        $('.clear-filter').on('click', function() {
            var $dropdown = $(this).closest('.filter-dropdown');
            var colIdx = $dropdown.find('.apply-filter').data('col');
            $dropdown.find('.col-checkbox, .select-all-checkbox').prop('checked', false);
            $dropdown.find('.dropdown-search').val('').trigger('keyup');
            table.column(colIdx).search('', false, false).draw();
            $dropdown.addClass('hidden');
            $('th.th-filter').css('z-index', '10');
        });

        // 4. MODAL LOGIC
        const modal = $('#updateModal');
        
        $('#masterTable tbody').on('click', '.open-modal-btn', function() {
            $('#modal-l4-input').val($(this).data('l4'));
            $('#modal-cat-display').text($(this).data('l4'));
            
            $('#modal-pic-search').val('').trigger('keyup');
            $('.modal-pic-checkbox').prop('checked', false);
            
            var suggestedStr = $(this).data('suggested');
            var currentStr = $(this).data('pics');
            
            var picsToLoad = suggestedStr && <?= $role === 'Category Manager' ? 'true' : 'false' ?> ? suggestedStr : currentStr;
            
            if (picsToLoad) {
                var picArray = String(picsToLoad).split(',').map(item => item.trim());
                
                $('.modal-pic-checkbox').each(function() {
                    if (picArray.includes($(this).val())) {
                        $(this).prop('checked', true);
                    }
                });
            }
            
            modal.removeClass('hidden');
        });

        $('#modal-pic-search').on('keyup', function() {
            var searchTerm = $(this).val().toLowerCase();
            $('#modal-pic-list label').each(function() {
                var text = $(this).find('.pic-name-label').text().toLowerCase();
                $(this).toggle(text.indexOf(searchTerm) > -1);
            });
        });

        $('#closeModalBtn, #modalOverlay').on('click', function() {
            modal.addClass('hidden');
        });
    });
</script>

<?php require_once '../includes/footer.php'; ?>