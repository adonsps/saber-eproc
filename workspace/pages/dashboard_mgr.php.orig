<?php
// pages/dashboard_mgr.php
require_once '../includes/auth.php';
require_manager();
require_once '../config/database.php';
// Vendor Evaluation v2 sender library — pulled in for ve2_csrf_token() only.
// It is a pure function library: no DB, no WA, no email on include.
require_once '../includes/vendor_eval_v2_sender.php';

// --- PHASE D-1: PROJECT PGROUP EXCLUSION ------------------------------------
// Mapped active Project PGroups belong to the Project Head dashboard
// (dashboard_project_head.php), not this Non-Project Manager dashboard. We
// exclude every PR whose p_group is an ACTIVE row in project_pgroups from the
// assignable/unassigned-PR queries, the workload chart, and the manual
// reassignment handler below. Compatibility: if the project_pgroups table is
// not deployed yet we fail OPEN (no exclusion, legacy behaviour, never fatal).
$project_pgroups_available = false;
try {
    $pdo->query("SELECT 1 FROM project_pgroups LIMIT 1");
    $project_pgroups_available = true;
} catch (PDOException $e) {
    $project_pgroups_available = false;
}
// Reusable SQL fragment appended to PR queries (PR table named/aliased `prs`).
// Empty string when project_pgroups is unavailable so queries stay valid.
$project_exclude_sql = $project_pgroups_available
    ? " AND NOT EXISTS (SELECT 1 FROM project_pgroups pp WHERE pp.p_group = prs.p_group AND pp.status = 'ACTIVE')"
    : "";

// --- CANVASSING_STATUS COMPATIBILITY GUARD ----------------------------------
// prs.canvassing_status may not exist on every environment (e.g. local dev DBs
// created before this column shipped). Detect it with a read-only SHOW COLUMNS
// check and swap in a harmless NULL alias when absent so every query below
// keeps returning a canvassing_status key without ever touching the schema.
$canvassing_status_available = false;
try {
    $canvassing_status_available = (bool)$pdo->query("SHOW COLUMNS FROM prs LIKE 'canvassing_status'")->fetch();
} catch (PDOException $e) {
    $canvassing_status_available = false;
}
$canvassing_status_select = $canvassing_status_available ? 'prs.canvassing_status' : 'NULL AS canvassing_status';

$manager_username = $_SESSION['username'] ?? '';
$role = $_SESSION['role'] ?? '';
$full_access_allowlist = ['adonis.sutanto', 'teofilus.franky', 'hadi.risali'];

// --- HANDLE MANUAL RE-ASSIGNMENT (LINE-LEVEL, AJAX-capable) -----------------
// Manual reassignment targets the SPECIFIC ticket line items selected in the
// UI, never the whole ticket. Only prs.ticket_line_item values that were
// selected AND actually belong to the submitted ticket are updated, inside a
// transaction. AI assignment (assigned_by_ai = 1) still owns the whole ticket
// by majority vote -- this manual path always stamps assigned_by_ai = 0 and
// touches only the chosen lines.
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['reassign_ticket_no'], $_POST['new_pic'])) {
    // AJAX path (the normal one now): the dashboard submits the reassignment via
    // fetch with X-Requested-With so we can answer with JSON and let the page
    // update in place -- no reload, no lost filters/scroll. A non-AJAX POST (no
    // JS) still falls back to a one-shot session flash + redirect.
    $is_ajax = (isset($_SERVER['HTTP_X_REQUESTED_WITH'])
        && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest');

    // Single exit point for the reassignment outcome. Messages are safe/user-
    // facing only -- never SQL, PDO internals, or secrets. Extra keys
    // (ticket_no/lines/assigned_pic) drive the client-side in-place row update.
    $send_reassign_response = function($ok, $message, array $extra = []) use ($is_ajax) {
        if ($is_ajax) {
            if (!headers_sent()) { header('Content-Type: application/json; charset=utf-8'); }
            echo json_encode(array_merge([
                'ok'      => (bool)$ok,
                'type'    => $ok ? 'success' : 'error',
                'message' => $message,
            ], $extra));
            exit;
        }
        $_SESSION['reassign_flash'] = ['type' => $ok ? 'success' : 'error', 'message' => $message];
        header('Location: dashboard_mgr.php');
        exit;
    };

    $new_pic = trim($_POST['new_pic']);
    $ticket = trim((string)$_POST['reassign_ticket_no']);
    $pic_val = ($new_pic === '') ? null : $new_pic;

    // Selected line items (values are prs.ticket_line_item). Normalise to a
    // unique, non-empty list. Empty => nothing to do; we intentionally do NOT
    // fall back to a whole-ticket update.
    $raw_lines = $_POST['reassign_lines'] ?? [];
    if (!is_array($raw_lines)) { $raw_lines = [$raw_lines]; }
    $sel_lines = [];
    foreach ($raw_lines as $ln) {
        $ln = trim((string)$ln);
        if ($ln !== '') { $sel_lines[$ln] = true; }
    }
    $sel_lines = array_keys($sel_lines);

    if ($ticket === '' || empty($sel_lines)) {
        $send_reassign_response(false, 'Reassignment failed. No valid line items were selected for this ticket.');
    }

    // Never reassign a mapped active Project PGroup ticket through this
    // Non-Project dashboard -- this also blocks hand-crafted POST requests.
    $is_project_ticket = false;
    if ($project_pgroups_available) {
        $chk = $pdo->prepare("SELECT 1 FROM prs JOIN project_pgroups pp ON pp.p_group = prs.p_group AND pp.status = 'ACTIVE' WHERE prs.ticket_no = ? LIMIT 1");
        $chk->execute([$ticket]);
        $is_project_ticket = (bool)$chk->fetchColumn();
    }

    $reassign_allowed = true;

    // Outcome bookkeeping for the feedback response below. This does NOT alter
    // the assignment/validation logic -- it only records what happened.
    $reassign_result = null;   // 'success' | 'db_error' | 'no_valid_lines'
    $updated_count   = 0;
    $valid_lines     = [];    // the exact lines the DB write touched (echoed back on success)

    if (!$is_project_ticket && $reassign_allowed) {
        // Confirm the selected lines actually belong to this ticket before
        // writing, so a hand-crafted POST can never move lines from another
        // ticket. Only the intersection is updated; unselected lines of the
        // ticket stay untouched.
        $line_ph = implode(',', array_fill(0, count($sel_lines), '?'));
        $vstmt = $pdo->prepare("SELECT ticket_line_item FROM prs WHERE ticket_no = ? AND ticket_line_item IN ($line_ph)");
        $vstmt->execute(array_merge([$ticket], $sel_lines));
        $valid_lines = $vstmt->fetchAll(PDO::FETCH_COLUMN);

        if (!empty($valid_lines)) {
            $upd_ph = implode(',', array_fill(0, count($valid_lines), '?'));
            try {
                $pdo->beginTransaction();
                $updateStmt = $pdo->prepare("UPDATE prs SET assigned_pic = ?, assigned_by_ai = 0 WHERE ticket_no = ? AND ticket_line_item IN ($upd_ph)");
                $updateStmt->execute(array_merge([$pic_val, $ticket], $valid_lines));
                
                // Update master data if requested
                $update_master_data = isset($_POST['update_master_data']) && $_POST['update_master_data'] == '1';
                if ($update_master_data && $role === 'Category Manager') {
                    $md_stmt = $pdo->prepare("SELECT DISTINCT master_data_id FROM prs WHERE ticket_no = ? AND ticket_line_item IN ($upd_ph) AND master_data_id IS NOT NULL");
                    $md_stmt->execute(array_merge([$ticket], $valid_lines));
                    $md_ids = $md_stmt->fetchAll(PDO::FETCH_COLUMN);
                    if (!empty($md_ids)) {
                        $md_in = implode(',', array_fill(0, count($md_ids), '?'));
                        $new_md_pic = $pic_val === null ? '' : $pic_val;
                        $md_upd = $pdo->prepare("UPDATE master_data SET pic_names = ?, suggested_pic_names = NULL, suggested_by = NULL WHERE id IN ($md_in)");
                        $md_upd->execute(array_merge([$new_md_pic], $md_ids));
                    }
                }
                
                $pdo->commit();
                $reassign_result = 'success';
                $updated_count   = count($valid_lines);
            } catch (PDOException $e) {
                if ($pdo->inTransaction()) { $pdo->rollBack(); }
                $reassign_result = 'db_error';
            }
        } else {
            $reassign_result = 'no_valid_lines';
        }
    }

    // --- Feedback response (JSON for AJAX, else one-shot session flash) -----
    // Messages are safe/user-facing only -- no SQL, no PDO internals, no
    // secrets. $send_reassign_response() exits, so exactly one branch fires.
    if (!$reassign_allowed) {
        $send_reassign_response(false, "Reassignment failed. The selected PIC is not eligible for this ticket's team.");
    } elseif ($is_project_ticket) {
        $send_reassign_response(false, 'Reassignment failed. This ticket is managed on the Project dashboard.');
    } elseif ($reassign_result === 'success') {
        $success_message = ($pic_val === null)
            ? ('Reassignment successful. ' . $updated_count . ' line item(s) from ticket ' . $ticket . ' were set to Unassigned.')
            : ('Reassignment successful. ' . $updated_count . ' line item(s) from ticket ' . $ticket . ' were reassigned to ' . $pic_val . '.');
        // Echo back the exact ticket + lines the DB write touched and the
        // resulting PIC (null => Unassigned) so the client can update just
        // those visible rows.
        $send_reassign_response(true, $success_message, [
            'ticket_no'    => $ticket,
            'lines'        => array_map('strval', $valid_lines),
            'assigned_pic' => $pic_val,
        ]);
    } elseif ($reassign_result === 'db_error') {
        $send_reassign_response(false, 'Reassignment failed. A database error occurred while updating the selected lines. No changes were saved.');
    } else {
        // no_valid_lines: the submitted lines did not belong to this ticket.
        $send_reassign_response(false, 'Reassignment failed. No valid line items were selected for this ticket.');
    }
}
require_once '../includes/header.php';
?>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>.select2-container { z-index: 1060 !important; } .select2-selection { font-size: 0.75rem; padding: 0.25rem; border-color: #d1d5db !important; }</style>
<?php

// One-shot reassignment feedback flash from the POST handler above -- read
// once, then cleared so a browser refresh doesn't replay it. Rendered as a
// modal below (non-AJAX fallback path only).
$reassign_flash = $_SESSION['reassign_flash'] ?? null;
unset($_SESSION['reassign_flash']);

// --- FETCH DATA ---
// One Workload Dashboard, three personas:
//   COMBINED   = Full-access allowlist OR Category Manager: Non-Project rows + every active Project group.
//   PROJECT    = Manager who heads at least one active Project group (Rio/Fabian):
//                ONLY their Project group(s); no Non-Project rows.
//   NONPROJECT = Manager with no Project group (Susi/Jimmy/Michelle):
//                the original Non-Project behaviour, completely unchanged.
// get_project_head_groups() fails closed to [] (e.g. project tables not deployed),
// so a Non-Project manager always resolves to NONPROJECT and behaves as before.

$project_groups = function_exists('get_project_head_groups')
    ? get_project_head_groups($pdo, $_SESSION)
    : [];
if (in_array($manager_username, $full_access_allowlist) || $role === 'Category Manager') {
    $persona = 'COMBINED';
} elseif ($role === 'Manager' && !empty($project_groups)) {
    $persona = 'PROJECT';
} else {
    $persona = 'NONPROJECT';
}


$all_prs     = [];   // unified display rows (each tagged with _row_type)
$workload_np = [];   // Non-Project workload: assigned_pic => open-PR count
$all_pics    = [];   // Non-Project assignable PIC pool (reassign modal + filter)

// Non-Project team short codes (UI-only; mirrors the analytics acronym map in
// cost_savings.php). Used to derive per-row team labels for the COMBINED team
// filter from existing pgroup_team_mappings.team_name -- display only.
$np_acronym_map = [
    'Corporate Services, General Supplies & Marketing' => 'CSGSM',
    'Technology, Industrial, and General Services'      => 'TIGS',
    'FNB and Operational Merchandise'                   => 'FNBOM',
    'Admin Team'                                        => 'ADMIN',
    'Project Konstruksi Retail'                         => 'PKR',
    'Project Konstruksi Properti'                       => 'PKP',
    'Maintenance & Facility Management'                 => 'MFM',
];
$np_team_code = function($team_name) use ($np_acronym_map) {
    $t = trim((string)$team_name);
    if ($t === '') return '';
    return $np_acronym_map[$t] ?? $t;
};

// ===== NON-PROJECT SOURCE (NONPROJECT + COMBINED) ==========================
if ($persona === 'COMBINED') {
    // Category Manager: every Non-Project PR (active Project PGroups excluded).
    $stmt = $pdo->query("SELECT prs.ticket_no, prs.ticket_line_item, prs.master_data_id, prs.pr_date, prs.p_org, prs.requestor_name, prs.item_description, prs.status_ticket, prs.assigned_pic, prs.assigned_by_ai, prs.canvassing_no, {$canvassing_status_select}, prs.canvassing_date, prs.po_number, prs.po_amount, m.team_name, prs.ticket_type FROM prs LEFT JOIN pgroup_team_mappings m ON prs.p_group = m.p_group WHERE LOWER(prs.status_ticket) NOT LIKE '%cancel%' AND (prs.pr_date >= '2026-05-01' OR prs.pr_date IS NULL)" . $project_exclude_sql . " ORDER BY prs.created_at DESC");
    $np_prs = $stmt->fetchAll();

    $chartStmt = $pdo->query("SELECT assigned_pic, COUNT(*) as count FROM prs WHERE assigned_pic IS NOT NULL AND LOWER(status_ticket) NOT LIKE '%cancel%' AND (po_number IS NULL OR TRIM(po_number) = '') AND (pr_date >= '2026-05-01' OR pr_date IS NULL)" . $project_exclude_sql . " GROUP BY assigned_pic");
    foreach ($chartStmt->fetchAll() as $row) { $workload_np[$row['assigned_pic']] = (int)$row['count']; }

    $picStmt = $pdo->query("SELECT name FROM users WHERE role IN ('PIC', 'Admin') ORDER BY name ASC");
    $all_pics = $picStmt->fetchAll(PDO::FETCH_COLUMN);

    foreach ($np_prs as $r) { $r['_row_type'] = 'nonproject'; $r['np_team'] = $np_team_code($r['team_name'] ?? ''); $all_prs[] = $r; }
} elseif ($persona === 'NONPROJECT') {
    // For Manager role: Get all PICs managed by this manager recursively
    $subordinates = get_all_subordinates($pdo, $manager_username);
    foreach ($subordinates as $sub) {
        if ($sub['role'] === 'PIC' || $sub['role'] === 'Admin') {
            $all_pics[] = $sub['name'];
        }
    }
    $all_pics = array_unique($all_pics);
    sort($all_pics);

    if (count($all_pics) > 0) {
        // Get PRs assigned to any of this manager's PICs, or unassigned PRs, or intercompany tickets
        $inQuery = implode(',', array_fill(0, count($all_pics), '?'));
        $prStmt = $pdo->prepare("SELECT prs.ticket_no, prs.ticket_line_item, prs.master_data_id, prs.pr_date, prs.p_org, prs.requestor_name, prs.item_description, prs.status_ticket, prs.assigned_pic, prs.assigned_by_ai, prs.canvassing_no, {$canvassing_status_select}, prs.canvassing_date, prs.po_number, prs.po_amount, prs.ticket_type FROM prs LEFT JOIN pgroup_team_mappings m ON prs.p_group = m.p_group WHERE (prs.assigned_pic IN ($inQuery) OR prs.assigned_pic IS NULL OR LOWER(prs.ticket_type) IN ('intercompany', 'intercompany new store')) AND LOWER(prs.status_ticket) NOT LIKE '%cancel%' AND (prs.pr_date >= '2026-05-01' OR prs.pr_date IS NULL)" . $project_exclude_sql . " ORDER BY prs.created_at DESC");
        $prStmt->execute($all_pics);
        $np_prs = $prStmt->fetchAll();

        $chartStmt = $pdo->prepare("SELECT assigned_pic, COUNT(*) as count FROM prs WHERE assigned_pic IN ($inQuery) AND LOWER(status_ticket) NOT LIKE '%cancel%' AND (po_number IS NULL OR TRIM(po_number) = '') AND (pr_date >= '2026-05-01' OR pr_date IS NULL)" . $project_exclude_sql . " GROUP BY assigned_pic");
        $chartStmt->execute($all_pics);
        foreach ($chartStmt->fetchAll() as $row) { $workload_np[$row['assigned_pic']] = (int)$row['count']; }
    } else {
        // Manager has no PICs: show all PRs
        $prStmt = $pdo->query("SELECT prs.ticket_no, prs.ticket_line_item, prs.master_data_id, prs.pr_date, prs.p_org, prs.requestor_name, prs.item_description, prs.status_ticket, prs.assigned_pic, prs.assigned_by_ai, prs.canvassing_no, {$canvassing_status_select}, prs.canvassing_date, prs.po_number, prs.po_amount, prs.ticket_type FROM prs LEFT JOIN pgroup_team_mappings m ON prs.p_group = m.p_group WHERE LOWER(prs.status_ticket) NOT LIKE '%cancel%' AND (prs.pr_date >= '2026-05-01' OR prs.pr_date IS NULL)" . $project_exclude_sql . " ORDER BY prs.created_at DESC");
        $np_prs = $prStmt->fetchAll();
    }
    foreach ($np_prs as $r) { $r['_row_type'] = 'nonproject'; $all_prs[] = $r; }
}

// ===== PROJECT SOURCE (PROJECT + COMBINED) =================================
// Mirrors dashboard_project_head.php: NO AI. Effective officer = assigned_pic,
// then parsed GP OFFICER resolved to an eligible officer, then source-backed
// Ridwan Arifin, else Unassigned. Assignment is manual via ajax_project_assign.php
// scoped to ticket_no + p_group; Intercompany rows stay read-only/system-routed.
$project_workload   = [];   // effective officer => ticket+p_group unit count
$officers_by_pgroup = [];   // p_group => [officer names]  (JS assign modal pool)
$project_team_codes = [];   // group_number => 'PKR' | 'PKP' | 'MFM' | 'G#'
if (($persona === 'PROJECT' || $persona === 'COMBINED') && $project_pgroups_available && !empty($project_groups)) {
    // Short codes are UI-only; canonical full names come from the DB.
    $team_short_codes = [1 => 'PKR', 2 => 'PKP', 3 => 'MFM'];
    $team_code = function($n) use ($team_short_codes) {
        return $team_short_codes[(int)$n] ?? ('G' . (int)$n);
    };
    foreach ($project_groups as $gn) { $project_team_codes[(int)$gn] = $team_code($gn); }

    $group_ph = implode(',', array_fill(0, count($project_groups), '?'));

    // Eligible officer pools + resolver (display hints + assign-modal options).
    $officers_by_group_number = [];
    $officer_resolver = [];
    $ostmt = $pdo->prepare("SELECT p_group, project_group_number, officer_name, officer_nip
                            FROM project_pgroup_officers
                            WHERE active = 1 AND project_group_number IN ($group_ph)
                            ORDER BY officer_name");
    $ostmt->execute($project_groups);
    foreach ($ostmt->fetchAll(PDO::FETCH_ASSOC) as $o) {
        $pg = $o['p_group']; $gnum = (int)$o['project_group_number'];
        $officers_by_pgroup[$pg][] = $o['officer_name'];
        if (!isset($officers_by_group_number[$gnum]) || !in_array($o['officer_name'], $officers_by_group_number[$gnum], true)) {
            $officers_by_group_number[$gnum][] = $o['officer_name'];
        }
        $officer_resolver[$pg]['names'][strtolower(trim((string)$o['officer_name']))] = $o['officer_name'];
        $nip = trim((string)$o['officer_nip']);
        if ($nip !== '') { $officer_resolver[$pg]['nips'][$nip] = $o['officer_name']; }
    }

    // Resolve a raw GP OFFICER string to an eligible officer for $p_group (display only).
    $resolve_gp_officer = function($p_group, $gp_officer) use ($officer_resolver) {
        $gp = trim((string)$gp_officer);
        if ($gp === '' || !isset($officer_resolver[$p_group])) return null;
        $map = $officer_resolver[$p_group];
        $lc = strtolower($gp);
        if (isset($map['names'][$lc])) return $map['names'][$lc];
        if (preg_match('/^\d+/', $gp, $m) && isset($map['nips'][$m[0]])) return $map['nips'][$m[0]];
        return null;
    };
    // Source-backed Ridwan Arifin exception (Admin, intentionally NOT an officer):
    // counts toward workload only when the parsed GP OFFICER literally names him.
    $ridwan_user_exists = (bool)$pdo
        ->query("SELECT 1 FROM users WHERE username = 'ridwan.arifin' AND name = 'Ridwan Arifin' LIMIT 1")
        ->fetchColumn();
    $resolve_effective_officer = function($row) use ($resolve_gp_officer, $ridwan_user_exists) {
        $pic = trim((string)($row['assigned_pic'] ?? ''));
        if ($pic !== '') return $pic;
        $resolved = $resolve_gp_officer($row['p_group'] ?? '', $row['gp_officer'] ?? '');
        if ($resolved !== null) return $resolved;
        if ($ridwan_user_exists && strtolower(trim((string)($row['gp_officer'] ?? ''))) === 'ridwan arifin') return 'Ridwan Arifin';
        return null;
    };

    // Main project fetch, scoped to the persona's allowed groups.
    $pstmt = $pdo->prepare("
        SELECT prs.ticket_no, prs.ticket_line_item, prs.master_data_id, prs.pr_date, prs.p_org, prs.p_group, prs.requestor_name,
               prs.item_description, prs.status_ticket, prs.canvassing_no, {$canvassing_status_select}, prs.canvassing_date,
               prs.po_number, prs.po_amount, prs.ticket_type, prs.vendor_name, prs.assigned_pic, prs.assigned_by_ai,
               prs.gp_officer, pp.project_group_number, pp.project_group_name
        FROM prs
        JOIN project_pgroups pp ON prs.p_group = pp.p_group AND pp.status = 'ACTIVE'
        WHERE pp.project_group_number IN ($group_ph)
          AND LOWER(prs.status_ticket) NOT LIKE '%cancel%'
          AND (prs.pr_date >= '2026-05-01' OR prs.pr_date IS NULL)
        ORDER BY prs.created_at DESC
    ");
    $pstmt->execute($project_groups);
    $project_lines = $pstmt->fetchAll(PDO::FETCH_ASSOC);

    $intercompany_types = ['intercompany', 'intercompany new store'];
    foreach ($project_lines as &$pl) {
        $pl['is_intercompany'] = in_array(strtolower(trim((string)$pl['ticket_type'])), $intercompany_types, true);
    }
    unset($pl);

    // Aggregate to one visible row per ticket_no + p_group (assignment scope).
    $grouped = [];
    foreach ($project_lines as $line) {
        $key = $line['ticket_no'] . '|' . $line['p_group'];
        if (!isset($grouped[$key])) { $line['line_count'] = 1; $grouped[$key] = $line; continue; }
        $g = &$grouped[$key];
        $g['line_count']++;
        if (trim((string)$g['assigned_pic']) === '' && trim((string)$line['assigned_pic']) !== '') {
            $g['assigned_pic'] = $line['assigned_pic'];
        }
        if (trim((string)($g['gp_officer'] ?? '')) === '' && trim((string)($line['gp_officer'] ?? '')) !== '') {
            $g['gp_officer'] = $line['gp_officer'];
        }
        if (!empty($line['is_intercompany'])) { $g['is_intercompany'] = true; }
        unset($g);
    }

    foreach ($grouped as $g) {
        $eff = $resolve_effective_officer($g);
        if ($eff !== null) { $project_workload[$eff] = ($project_workload[$eff] ?? 0) + 1; }
        $resolved_officer = (empty($g['is_intercompany']) && trim((string)$g['assigned_pic']) === '')
            ? $resolve_gp_officer($g['p_group'], $g['gp_officer'] ?? '')
            : null;
        $all_prs[] = [
            '_row_type'            => 'project',
            'ticket_no'            => $g['ticket_no'],
            'ticket_line_item'     => $g['ticket_line_item'] ?? '',
            'master_data_id'       => $g['master_data_id'] ?? null,
            'pr_date'              => $g['pr_date'],
            'p_org'                => $g['p_org'],
            'requestor_name'       => $g['requestor_name'],
            'item_description'     => $g['item_description'],
            'canvassing_no'        => $g['canvassing_no'],
            'canvassing_status'    => $g['canvassing_status'],
            'canvassing_date'      => $g['canvassing_date'],
            'status_ticket'        => $g['status_ticket'],
            'po_number'            => $g['po_number'],
            'ticket_type'          => $g['ticket_type'],
            'assigned_pic'         => $g['assigned_pic'],
            'assigned_by_ai'       => $g['assigned_by_ai'],
            'p_group'              => $g['p_group'],
            'project_group_number' => (int)$g['project_group_number'],
            'project_group_name'   => $g['project_group_name'],
            'team_code'            => $team_code($g['project_group_number']),
            'is_intercompany'      => !empty($g['is_intercompany']),
            'line_count'           => $g['line_count'] ?? 1,
            'effective_officer'    => $eff,
            'resolved_officer'     => $resolved_officer,
        ];
    }

    // PROJECT persona has no Non-Project source, so seed the Assigned-PIC filter
    // dropdown from the eligible Project officer pool (COMBINED already lists all PICs).
    if ($persona === 'PROJECT') {
        $proj_officer_names = [];
        foreach ($officers_by_group_number as $names) {
            foreach ($names as $n) { $proj_officer_names[$n] = true; }
        }
        $all_pics = array_keys($proj_officer_names);
        sort($all_pics);
    }
}

// --- TEAM FILTER OPTIONS (persona-aware, UI-only) --------------------------
// COMBINED: the full canonical Non-Project team structure + Project codes.
// PROJECT:  only the manager's Project codes.
// The filter row is hidden when a persona has a single available team (e.g.
// Fabian = PKP only), so we never render a one-option filter.
$np_team_codes = [];
if ($persona === 'COMBINED') {
    // Phase F-6: always render the canonical Non-Project teams (CSGSM / TIGS /
    // FNBOM) for the Category Manager dashboard, even when a team has zero rows in
    // the current dataset. Deriving the list from the rows alone dropped any team
    // absent today (e.g. FNBOM). Filtering a zero-row team simply shows no rows
    // (see the team-filter search handler). ADMIN is intentionally not a main team
    // filter here. We are adding ADMIN now per user request.
    $np_team_codes = ['CSGSM', 'TIGS', 'FNBOM', 'MFM', 'PKP', 'PKR', 'ADMIN'];
}
$show_team_filter = (count($np_team_codes) + count($project_team_codes)) > 1;

// --- NON-PROJECT TEAM -> ELIGIBLE PIC POOL (COMBINED only) ----------
// Used for filtering dashboard UI by team.
$np_pics_by_team  = [];   // 'CSGSM' => [pic, ...]
if ($persona === 'COMBINED') {
    try {
        $pmrows = $pdo->query("SELECT name as pic_name, team_name FROM users WHERE role IN ('PIC', 'Admin') AND name IS NOT NULL AND name <> ''")->fetchAll(PDO::FETCH_ASSOC);
        foreach ($pmrows as $pm) {
            $code = $np_team_code($pm['team_name'] ?? '');
            if ($code === '') { continue; }
            $np_pics_by_team[$code][$pm['pic_name']] = true;
        }
    } catch (PDOException $e) {
        $np_pics_by_team = [];
    }
    foreach ($np_pics_by_team as $code => $set) { $names = array_keys($set); sort($names); $np_pics_by_team[$code] = $names; }
}

// --- CALCULATE SMART STATUS ---
foreach ($all_prs as &$pr) {
    $has_canv = !empty(trim((string)$pr['canvassing_no']));
    $has_po   = !empty(trim((string)$pr['po_number']));
    $raw_status = strtolower(trim((string)$pr['status_ticket']));

    $canvassing_status = strtolower(trim((string)($pr['canvassing_status'] ?? '')));

    if (strpos($canvassing_status, 'cancel') !== false) {
        $pr['display_status'] = 'Canvassing Cancelled';
    } elseif (strpos($raw_status, 'escalated') !== false) {
        $pr['display_status'] = 'Escalated';
    } elseif (strpos($raw_status, 'reject') !== false || strpos($raw_status, 'revise') !== false) {
        $pr['display_status'] = 'Sendback';
    } elseif ($has_po) {
        $pr['display_status'] = 'PO Created';
    } elseif ($has_canv) {
        $pr['display_status'] = 'On Progress';
    } else {
        $pr['display_status'] = 'Outstanding';
    }
}
unset($pr);

// --- UNIFIED WORKLOAD (persona-aware) --------------------------------------
// NONPROJECT: open PRs (no PO) per assigned_pic.
// PROJECT:    ticket+P.Group units per effective Project officer.
// COMBINED:   both, summed by name into one chart. Units differ between sources
// (see the chart subtitle); the bar tooltip always shows the full name.
$workload_merged = $workload_np;
foreach ($project_workload as $name => $cnt) {
    $workload_merged[$name] = ($workload_merged[$name] ?? 0) + $cnt;
}
arsort($workload_merged);
$chart_labels = array_keys($workload_merged);
$chart_counts = array_values($workload_merged);

$chart_raw_data = [];
foreach ($all_prs as $pr) {
    if (empty($pr['assigned_pic'])) continue;
    $teamName = 'Unknown Team';
    if (($pr['_row_type'] ?? '') === 'nonproject') {
        $picActualTeam = null;
        foreach ($np_pics_by_team as $t => $pics) {
            if (in_array($pr['assigned_pic'], $pics, true)) {
                $picActualTeam = $t;
                break;
            }
        }
        $teamName = $picActualTeam ? $picActualTeam : (!empty($pr['np_team']) ? $pr['np_team'] : 'Unknown Team');
    } else {
        $teamName = !empty($pr['team_code']) ? $pr['team_code'] : 'Unknown Team';
    }
    $chart_raw_data[] = [
        'ticket_no' => $pr['ticket_no'],
        'assigned_pic' => $pr['assigned_pic'],
        'team_name' => $teamName,
        'canvassing_no' => $pr['canvassing_no'] ?? '',
        'po_number' => $pr['po_number'] ?? '',
        'po_amount' => (float)($pr['po_amount'] ?? 0)
    ];
}

$unique_tickets = array_unique(array_column($all_prs, 'ticket_no'));
$unique_porgs = array_filter(array_unique(array_column($all_prs, 'p_org')));
$unique_requestors = array_filter(array_unique(array_column($all_prs, 'requestor_name')));
$unique_statuses = array_filter(array_unique(array_column($all_prs, 'display_status')));

sort($unique_tickets);
sort($unique_porgs);
sort($unique_requestors);
sort($unique_statuses);

// --- LAST UPDATED (Task C) --------------------------------------------------
// Newest prs.created_at
$last_updated_label = 'unavailable';
try {
    date_default_timezone_set('Asia/Jakarta');
    $li = $pdo->query("SELECT MAX(created_at) FROM prs")->fetchColumn();
    if (!empty($li)) { $last_updated_label = date('d M Y, H:i', strtotime($li)) . ' WIB'; }
} catch (PDOException $e) {
    $last_updated_label = 'unavailable';
}
?>

